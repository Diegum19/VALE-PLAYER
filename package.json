{
  "name": "vela-player",
  "productName": "Vela Player",
  "version": "1.1.0",
  "description": "Vela Player 1.1.0 - motor nativo MPV para ampliar a compatibilidade de vídeo",
  "main": "main.js",
  "author": "Vela Player",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "start": "npm run vendor && electron .",
    "test": "node test/core.test.js",
    "dist": "npm run vendor && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "mpegts.js": "1.8.2",
    "dashjs": "5.2.1",
    "electron-mpv-video": "0.1.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0"
  },
  "build": {
    "appId": "br.velaplayer.app",
    "productName": "Vela Player",
    "copyright": "Vela Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "THIRD-PARTY-LICENSES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vela Player",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Instalar-Vela-Player.${ext}"
    },
    "asarUnpack": [
      "node_modules/electron-mpv-video/native/mpv-addon/build/Release/*.node",
      "node_modules/electron-mpv-video/native/mpv-addon/build/Release/*.dll"
    ]
  },
  "overrides": {
    "electron-mpv-video": {
      "node-gyp": "^12.2.0"
    }
  }
}
